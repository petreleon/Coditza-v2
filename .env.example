# Coditza local-development defaults.
# Obtain the Supabase values from `supabase status` when the local stack exists.

NODE_ENV=development
APP_ENV=local
HOST=127.0.0.1
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGINS=
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
ATTEMPT_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_MAX=30
CONNECTION_TIMEOUT_MS=10000
REQUEST_RECEIVE_TIMEOUT_MS=30000
DEPENDENCY_TIMEOUT_MS=10000
HANDLER_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000
READINESS_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
SWAGGER_UI_ENABLED=true

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_REF=local
SUPABASE_PUBLISHABLE_KEY=replace_with_local_publishable_key
SUPABASE_SECRET_KEY=replace_with_local_secret_key
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

CURSOR_HMAC_SECRET=replace_with_base64url_encoded_32_random_bytes
REQUEST_ID_HEADER=x-request-id

# Keep disabled until ARC-WASM-001 and G-WASM approve an exact runtime and
# hardened outer-sandbox launcher. The two commented values become mandatory
# only when the grader is enabled.
PYTHON_GRADER_ENABLED=false
# PYTHON_WASM_RUNTIME_MANIFEST=/absolute/path/to/python-wasm-runtime.lock.json
# PYTHON_SANDBOX_LAUNCHER_PROFILE=replace_with_approved_profile_id
PYTHON_GRADER_CONCURRENCY=2
PYTHON_GRADER_CLAIM_BATCH_SIZE=2
PYTHON_GRADER_POLL_INTERVAL_MS=1000
PYTHON_GRADER_LEASE_MS=30000
PYTHON_GRADER_MAX_RETRIES=2
PYTHON_GRADER_QUEUE_LIMIT=1000
