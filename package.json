{
  "name": "coditza",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "format": "prettier --write package.json python-wasm-runtime.lock.json tsconfig.base.json eslint.config.js .dependency-cruiser.cjs apps/api/package.json apps/api/tsconfig.json apps/api/tsconfig.test.json apps/api/vitest.config.ts apps/api/src apps/api/test scripts/python-wasm scripts/supabase",
    "format:check": "prettier --check package.json python-wasm-runtime.lock.json tsconfig.base.json eslint.config.js .dependency-cruiser.cjs apps/api/package.json apps/api/tsconfig.json apps/api/tsconfig.test.json apps/api/vitest.config.ts apps/api/src apps/api/test scripts/python-wasm scripts/supabase",
    "lint": "eslint apps/api/src apps/api/test/support apps/api/vitest.config.ts && npm run boundaries",
    "boundaries": "depcruise --config .dependency-cruiser.cjs -- apps/api/src",
    "typecheck:api": "npm run typecheck --workspace=@coditza/api",
    "typecheck:test": "tsc --project apps/api/tsconfig.test.json",
    "typecheck": "npm run typecheck:api && npm run typecheck:test",
    "build": "npm run build --workspace=@coditza/api",
    "dev": "npm run dev --workspace=@coditza/api",
    "start": "npm run start --workspace=@coditza/api",
    "test:boundaries": "node apps/api/test/boundaries/verify-fixtures.mjs",
    "test:unit": "vitest run --configLoader runner --config apps/api/vitest.config.ts --project unit",
    "test:integration": "vitest run --configLoader runner --config apps/api/vitest.config.ts --project integration",
    "test:contract": "vitest run --configLoader runner --config apps/api/vitest.config.ts --project contract",
    "test:db": "vitest run --configLoader runner --config apps/api/vitest.config.ts --project db",
    "test:e2e": "vitest run --configLoader runner --config apps/api/vitest.config.ts --project e2e",
    "test:security": "vitest run --configLoader runner --config apps/api/vitest.config.ts --project security",
    "supabase:start:local": "node scripts/supabase/local-stack.mjs start",
    "supabase:status:local": "node scripts/supabase/local-stack.mjs status",
    "supabase:capture-env:local": "node scripts/supabase/local-stack.mjs capture-env",
    "supabase:verify-resets:local": "node scripts/supabase/local-stack.mjs verify-resets",
    "supabase:verify-primitives:local": "node scripts/supabase/local-stack.mjs verify-primitives",
    "supabase:verify-auth-profiles:local": "node scripts/supabase/local-stack.mjs verify-auth-profiles",
    "supabase:verify-core-content:local": "node scripts/supabase/local-stack.mjs verify-core-content",
    "supabase:verify-assessments:local": "node scripts/supabase/local-stack.mjs verify-assessments",
    "supabase:verify-learning-records:local": "node scripts/supabase/local-stack.mjs verify-learning-records",
    "supabase:stop:local": "node scripts/supabase/local-stack.mjs stop",
    "build:wasm-local": "node scripts/python-wasm/build-local-sandbox.mjs --update-lock",
    "test:wasm": "node apps/api/test/wasm/require-approved-outer-sandbox.mjs",
    "test:coverage": "CODITZA_TEST_REPORTS=1 vitest run --configLoader runner --config apps/api/vitest.config.ts --project unit --coverage && node apps/api/test/support/verify-sanitized-reports.mjs apps/api/coverage",
    "test": "npm run test:unit && npm run test:boundaries",
    "check:foundation": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "supabase": "2.110.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "pyodide": "314.0.3"
  }
}
