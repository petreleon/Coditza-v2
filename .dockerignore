# Environment files and credentials must never enter the Docker build context.
.env
.env.*

# Repository and local tooling state.
.git
.gitignore
.DS_Store
.agents/
.codex/
.supabase/

# The API image never owns Supabase, course plans, or implementation reports.
supabase/
todo/
todo-curriculum-ro/
docs/

# Dependencies, generated output, and test artifacts
**/node_modules/
**/dist/
**/coverage/
**/test-results/
**/playwright-report/
.nyc_output/
